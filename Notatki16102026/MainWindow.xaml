<Window x:Class="Notatki16102026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aplikacja Notatki" Height="400" Width="500" WindowStartupLocation="CenterScreen">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="lstNotes" Grid.Row="0" Margin="0,0,0,15">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Content}" Padding="5" TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Dodaj notatkę" Click="BtnAdd_Click" Width="120" Height="30" Margin="0,0,10,0"/>
            <Button Content="Zapisz do pliku" Click="BtnSaveToFile_Click" Width="120" Height="30"/>
        </StackPanel>
    </Grid>
</Window>